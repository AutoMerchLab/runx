#!/bin/sh
set -eu

if [ -n "${RUNX_GITHUB_SYNC_GH_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$RUNX_GITHUB_SYNC_GH_LOG"
fi

case "$*" in
  *graphql*)
    /bin/cat >/dev/null
    printf '%s\n' '{"data":{"viewer":{"id":"U_operator","login":"operator"},"repository":{"nameWithOwner":"runxhq/runx","viewerPermission":"READ"}}}'
    ;;
  *"--method GET repos/runxhq/runx/issues?per_page=25&state=open&labels=triage"*)
    printf '%s\n' '[{"number":442,"title":"Make GitHub reads operator-first","state":"open","body":"Use the existing local gh session for routine reads.","html_url":"https://github.com/runxhq/runx/issues/442","labels":[{"name":"triage"}],"assignees":[]}]'
    ;;
  *)
    printf '%s\n' "unexpected fixture gh invocation: $*" >&2
    exit 2
    ;;
esac
