{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/send-as/result/v1.json",
  "x-runx-packet-id": "runx.send_as.result.v1",
  "type": "object",
  "properties": {
    "schema": { "const": "runx.send_as.result.v1" },
    "status": { "type": "string", "enum": ["sent", "failed"] },
    "outcome": { "type": "string", "enum": ["completed", "failed"] },
    "provider": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "content_digest": { "type": "string" },
    "operation_id": { "type": "string" },
    "readback_ref": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "evidence": {
      "type": "object",
      "properties": {
        "mutation_readback_ref": { "type": "string" },
        "verification_readback_ref": { "type": "string" }
      },
      "required": ["mutation_readback_ref", "verification_readback_ref"],
      "additionalProperties": false
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["schema", "status", "outcome", "provider", "target", "operation", "content_digest", "operation_id", "readback_ref", "idempotency_key", "evidence", "errors"],
  "additionalProperties": false
}
