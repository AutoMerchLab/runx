{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/issue-to-pr/result/v1.json",
  "x-runx-packet-id": "runx.issue_to_pr.result.v1",
  "type": "object",
  "required": ["schema", "status", "outcome", "repository", "issue_number", "branch", "tested", "finalization_ref", "publication", "errors"],
  "properties": {
    "schema": { "const": "runx.issue_to_pr.result.v1" },
    "status": { "type": "string", "enum": ["completed", "blocked"] },
    "outcome": { "type": "string", "enum": ["completed", "blocked"] },
    "repository": { "type": "string" },
    "issue_number": { "type": "string" },
    "branch": { "type": "string" },
    "tested": { "type": "boolean" },
    "finalization_ref": { "type": "string" },
    "publication": {
      "type": "object",
      "required": ["status", "pr_number", "url", "readback_ref"],
      "properties": {
        "status": { "type": "string", "enum": ["not_requested", "published"] },
        "pr_number": { "type": "string" },
        "url": { "type": "string" },
        "readback_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
